* text=auto eol=lf
# Integrity records hash the same canonical bytes on every checkout.
spec/** text eol=lf
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
# Preserve upstream vendored bytes for dependency digest verification.
source/third_party/** -text
# Native diagnostic evidence retains exact upstream bytes, including blank-line spaces.
build-support/evidence/w-05-gnome-focus-trace-journals/*-native_focus_log.log -text -whitespace
# Preserve exact Windows native stdout bytes referenced by observation digests.
build-support/evidence/w-03-windows-inventory-*-stdout.json -text whitespace=cr-at-eol
# Retain original Windows package-result bytes referenced by the checkpoint index.
build-support/evidence/w-25-gjs-network-view-windows-*.smoke.json -text whitespace=cr-at-eol
build-support/evidence/w-25-gnome-render-watch-windows-*.smoke.json -text whitespace=cr-at-eol
build-support/evidence/w-25-gnome-render-watch-compiled-history/*-windows-*.smoke.json -text whitespace=cr-at-eol
build-support/evidence/w-25-gnome-render-watch-first-build-records/*-windows-*.smoke.json -text whitespace=cr-at-eol
build-support/evidence/w-25-consumer-continuity-windows-*.smoke.json -text whitespace=cr-at-eol
build-support/evidence/w-25-consumer-continuity-compiled-history/windows-first-LastTest.log -text whitespace=cr-at-eol
# Preserve the native runner's original trailing spaces in these evidence logs.
build-support/evidence/w-25-consumer-continuity-compiled-history/linux-first-LastTest.log -text -whitespace
build-support/evidence/w-25-consumer-continuity-linux-x64-gcc13.ctest.txt -text -whitespace
build-support/evidence/w-25-gnome-controller-recovery-windows-*.smoke.json -text whitespace=cr-at-eol
build-support/evidence/w-25-gnome-controller-recovery-linux-x64-gcc13.ctest.txt -text -whitespace

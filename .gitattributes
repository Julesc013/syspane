* text=auto eol=lf
# Integrity records hash the same canonical bytes on every checkout.
spec/** text eol=lf
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
# Preserve upstream vendored bytes for dependency digest verification.
source/third_party/** -text

<?xml version="1.0"?>
<repository version="1.2" xmlns="http://www.gtk.org/introspection/core/1.0"
 xmlns:c="http://www.gtk.org/introspection/c/1.0" xmlns:glib="http://www.gtk.org/introspection/glib/1.0">
 <include name="GObject" version="2.0"/>
 <namespace name="SysPaneClock" version="0.1" shared-library="libsyspane_gjs_clock.so"
  c:identifier-prefixes="SysPane" c:symbol-prefixes="syspane">
  <class name="Clock" c:type="SysPaneClock" parent="GObject.Object"
   glib:type-name="SysPaneClock" glib:get-type="syspane_clock_get_type">
   <constructor name="new_from_socket" c:identifier="syspane_clock_new_from_socket" throws="1">
    <return-value transfer-ownership="full"><type name="Clock" c:type="SysPaneClock*"/></return-value>
    <parameters>
     <parameter name="fd" transfer-ownership="none"><type name="gint" c:type="gint"/></parameter>
     <parameter name="expected_pid" transfer-ownership="none"><type name="guint" c:type="guint"/></parameter>
    </parameters>
   </constructor>
   <method name="sample" c:identifier="syspane_clock_sample" throws="1">
    <return-value transfer-ownership="full"><type name="utf8" c:type="gchar*"/></return-value>
    <parameters><instance-parameter name="self" transfer-ownership="none"><type name="Clock" c:type="SysPaneClock*"/></instance-parameter></parameters>
   </method>
   <method name="close" c:identifier="syspane_clock_close">
    <return-value transfer-ownership="none"><type name="none" c:type="void"/></return-value>
    <parameters><instance-parameter name="self" transfer-ownership="none"><type name="Clock" c:type="SysPaneClock*"/></instance-parameter></parameters>
   </method>
  </class>
 </namespace>
</repository>

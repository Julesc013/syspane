{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/syspane/0.2.0/observation.schema.json",
  "title": "SysPane observation experimental 0.2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "entity_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
    },
    "field": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
    },
    "value": {
      "anyOf": [
        {
          "$ref": "https://schemas.example.invalid/syspane/0.1.0/common.schema.json#/$defs/value"
        },
        {
          "type": "null"
        }
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "origin": {
      "enum": [
        "observed",
        "derived",
        "configured"
      ]
    },
    "support": {
      "enum": [
        "supported",
        "unsupported",
        "unknown"
      ]
    },
    "acquisition": {
      "enum": [
        "success",
        "pending",
        "denied",
        "failed",
        "disabled"
      ]
    },
    "freshness": {
      "enum": [
        "current",
        "stale",
        "unknown",
        "not_applicable"
      ]
    },
    "presence": {
      "enum": [
        "present",
        "absent",
        "unknown"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
    },
    "observed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "attempted_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "producer_epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
    },
    "generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Unsigned decimal; semantic validator also enforces <= 18446744073709551615."
    },
    "sample_interval_ns": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "description": "Unsigned decimal; semantic validator also enforces <= 18446744073709551615."
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "https://schemas.example.invalid/syspane/0.1.0/common.schema.json#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
      }
    },
    "measured_at": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "clock_id": {
              "$ref": "https://schemas.example.invalid/syspane/0.1.0/common.schema.json#/$defs/id"
            },
            "nanoseconds": {
              "$ref": "https://schemas.example.invalid/syspane/0.1.0/common.schema.json#/$defs/uint64"
            }
          },
          "required": [
            "clock_id",
            "nanoseconds"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "entity_id",
    "field",
    "value",
    "unit",
    "origin",
    "support",
    "acquisition",
    "freshness",
    "presence",
    "source_id",
    "observed_at",
    "attempted_at",
    "producer_epoch",
    "generation",
    "sample_interval_ns",
    "error",
    "measured_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "acquisition": {
            "enum": [
              "denied",
              "failed"
            ]
          }
        },
        "required": [
          "acquisition"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "$ref": "https://schemas.example.invalid/syspane/0.1.0/common.schema.json#/$defs/error"
          }
        }
      }
    }
  ]
}

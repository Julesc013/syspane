{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/syspane/0.2.0/capability.schema.json",
  "title": "SysPane capability experimental 0.2.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
          },
          "implemented": {
            "type": "boolean"
          },
          "qualification": {
            "enum": [
              "not_qualified",
              "qualified",
              "failed",
              "inconclusive"
            ]
          },
          "availability": {
            "enum": [
              "available",
              "unavailable",
              "denied",
              "unknown"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 2048
          },
          "authorized": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
                },
                "artifact_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "environment_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "evidence_id",
                "artifact_sha256",
                "environment_sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 128
          }
        },
        "required": [
          "id",
          "implemented",
          "qualification",
          "availability",
          "reason",
          "authorized",
          "evidence"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "qualification": {
                  "const": "qualified"
                }
              }
            },
            "then": {
              "properties": {
                "implemented": {
                  "const": true
                },
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "maxItems": 2048
    },
    "environment": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": "string",
        "maxLength": 2048
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
      }
    },
    "target": {
      "$ref": "https://schemas.example.invalid/syspane/0.1.0/target-profile.schema.json"
    },
    "artifact_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "capabilities",
    "environment",
    "target",
    "artifact_sha256"
  ],
  "additionalProperties": false
}

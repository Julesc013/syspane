{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/syspane/0.1.0/binding.schema.json",
  "title": "SysPane binding experimental 0.1.0",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "selector"
        },
        "scope": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "local_host",
                    "current_session"
                  ]
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "registered_asset"
                },
                "asset_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
                }
              },
              "required": [
                "kind",
                "asset_id"
              ],
              "additionalProperties": false
            }
          ]
        },
        "entity_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
        },
        "mode": {
          "enum": [
            "singleton",
            "collection"
          ]
        },
        "predicates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
              },
              "op": {
                "enum": [
                  "eq",
                  "ne"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "boolean",
                  "number"
                ],
                "maxLength": 512
              }
            },
            "required": [
              "field",
              "op",
              "value"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 16
        },
        "sort": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
              },
              "direction": {
                "enum": [
                  "ascending",
                  "descending"
                ]
              }
            },
            "required": [
              "field",
              "direction"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 8
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
        }
      },
      "required": [
        "kind",
        "scope",
        "entity_type",
        "mode",
        "predicates",
        "sort",
        "limit",
        "field"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "direct"
        },
        "producer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
        },
        "producer_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
        },
        "entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
        }
      },
      "required": [
        "kind",
        "producer_id",
        "producer_epoch",
        "entity_id",
        "field"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "persistent_pin"
        },
        "scope": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "local_host",
                    "current_session"
                  ]
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "registered_asset"
                },
                "asset_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
                }
              },
              "required": [
                "kind",
                "asset_id"
              ],
              "additionalProperties": false
            }
          ]
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "entity_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
        }
      },
      "required": [
        "kind",
        "scope",
        "namespace",
        "key",
        "entity_type",
        "field"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "unresolved_pin"
        },
        "source_schema_version": {
          "const": "0.1.0"
        },
        "entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
        },
        "reason": {
          "const": "producer_context_required"
        }
      },
      "required": [
        "kind",
        "source_schema_version",
        "entity_id",
        "field",
        "reason"
      ],
      "additionalProperties": false
    }
  ]
}

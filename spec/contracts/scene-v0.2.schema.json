{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/syspane/0.2.0/scene.schema.json",
  "title": "SysPane scene experimental 0.2.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "scene_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
    },
    "theme_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "widgets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/widget"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "extensions": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
      }
    }
  },
  "required": [
    "schema_version",
    "revision",
    "scene_id",
    "theme_id",
    "roots",
    "widgets"
  ],
  "additionalProperties": false,
  "$defs": {
    "widget": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
        },
        "kind": {
          "enum": [
            "text",
            "value",
            "table",
            "chart",
            "status",
            "group",
            "image"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 512
        },
        "display": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
                }
              },
              "required": [
                "role"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "local_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
                }
              },
              "required": [
                "local_id"
              ],
              "additionalProperties": false
            }
          ]
        },
        "layout": {
          "$ref": "https://schemas.example.invalid/syspane/0.1.0/layout.schema.json"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.example.invalid/syspane/0.1.0/binding.schema.json"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "priority": {
          "enum": [
            "essential",
            "normal",
            "secondary"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "extensions": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "display",
        "layout",
        "bindings",
        "priority"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "group"
              }
            }
          },
          "then": {
            "required": [
              "children"
            ]
          },
          "else": {
            "not": {
              "required": [
                "children"
              ]
            }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/syspane/0.1.0/reconciliation-result.schema.json",
  "title": "SysPane committed-request reconciliation response 0.1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
    },
    "original_producer_epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
    },
    "result": {
      "allOf": [
        {
          "$ref": "https://schemas.example.invalid/syspane/0.1.0/command-result.schema.json"
        },
        {
          "properties": {
            "outcome": {
              "enum": [
                "accepted",
                "unknown"
              ]
            }
          },
          "if": {
            "properties": {
              "outcome": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "properties": {
              "revision": {
                "type": "string"
              },
              "stored": {
                "const": true
              },
              "durable": {
                "const": true
              },
              "visible": {
                "const": false
              },
              "error": {
                "type": "null"
              },
              "activation": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": {
                    "component": {
                      "const": "presentation"
                    },
                    "state": {
                      "const": "pending"
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "revision": {
                "type": "null"
              },
              "activation": {
                "maxItems": 0
              },
              "error": {
                "type": "object"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "query_id",
    "original_producer_epoch",
    "request_id",
    "result"
  ],
  "additionalProperties": false
}

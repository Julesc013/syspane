{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/syspane/0.1.0/content-catalog.schema.json",
  "title": "SysPane private content catalog experimental 0.1.0",
  "type": "object",
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "packages": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$", "maxLength": 64}
    }
  },
  "required": ["schema_version", "packages"],
  "additionalProperties": false
}

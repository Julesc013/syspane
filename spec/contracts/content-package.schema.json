{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/syspane/0.1.0/content-package.schema.json",
  "title": "SysPane content-package experimental 0.1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "package_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$",
      "maxLength": 64
    },
    "kind": {
      "enum": [
        "preset",
        "theme",
        "scene",
        "widget"
      ]
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$",
            "maxLength": 64
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "version",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:])[A-Za-z0-9_. /-]+$"
          },
          "media_type": {
            "enum": [
              "application/json",
              "image/png",
              "image/jpeg",
              "image/svg+xml",
              "font/woff2"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          }
        },
        "required": [
          "path",
          "media_type",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256
    },
    "total_unpacked_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "optional_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "version",
    "kind",
    "license",
    "dependencies",
    "assets",
    "total_unpacked_bytes",
    "required_capabilities",
    "optional_capabilities"
  ],
  "additionalProperties": false
}
